<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) requer que o background do root de um widget
    use um layer-list com clip-path, não um <shape> diretamente no root.
    O launcher usa clipToOutline para arredondar — qualquer shape no root
    com corners causa rejeição silenciosa ("Não foi possível adicionar widget").
    Solução: layer-list com item interno, permitindo que o root seja clipado.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EE1C1C1E" />
            <stroke
                android:width="1dp"
                android:color="#40FFD700" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
